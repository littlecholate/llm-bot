    async def process_message(self, chat_id: str, message: Dict):
        try:
            # 1. 基礎解析
            msg_id = message.get('id')
            body_data = message.get('body') or {}
            content = body_data.get('content', '')
            
            # ... (略過先前的 Feedback Check 邏輯，放在這裡之前) ...

            # 2. 自我過濾 (防止無限迴圈)
            from_user = message.get('from', {}).get('user', {})
            sender_id = from_user.get('id')
            if self.client.user_id and sender_id == self.client.user_id:
                return

            if not content:
                return

            # --- [關鍵新增: 群組靜默邏輯] ---
            # 從 Context 取得聊天室類型
            chat_type = self.memory.get_context(chat_id, "chat_type")
            
            # 定義是否需要回覆
            should_reply = False

            if chat_type == "oneOnOne":
                # 一對一聊天：永遠回覆
                should_reply = True
            else:
                # 群組聊天 (group, meeting)：檢查是否被 Mention
                mentions = message.get("mentions", [])
                
                # 遍歷所有被提及的人，看有沒有自己
                is_mentioned = False
                if mentions:
                    for m in mentions:
                        mentioned_user = m.get("mentioned", {}).get("user", {})
                        if mentioned_user.get("id") == self.client.user_id:
                            is_mentioned = True
                            break
                
                if is_mentioned:
                    self.logger.info(f"Bot mentioned in group chat {chat_id}. Processing.")
                    should_reply = True
                else:
                    self.logger.debug(f"Ignored message in group chat {chat_id} (No mention).")
                    return # <--- 直接結束，不處理，不存 Memory

            if not should_reply:
                return
            # --- [邏輯結束] ---

            
            clean_content = content.replace('<p>', '').replace('</p>', '').strip()
            self.logger.info(f"Received from {chat_id}: {clean_content}")

            # ... (後續圖片下載、記憶寫入、LLM 呼叫保持不變) ...





