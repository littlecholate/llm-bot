    async def send_typing_indicator(self, chat_id: str):
        """
        [New] 發送 'User is typing...' 狀態給 Teams
        注意：這個狀態通常只會維持約 5-10 秒，之後會自動消失。
        """
        url = f"{self.base_url}/me/chats/{chat_id}/sendActivityNotification"
        
        payload = {
            "type": "typing"
        }
        
        # 這裡我們使用既有的 _request 方法，它已經處理了 Headers 和 SSL
        # 我們不需要檢查回傳值，因為這只是一個狀態通知，失敗了也不影響主流程
        await self._request("POST", url, json_data=payload)





