    # core/bot_instance.py (run_forever 部分)

    async def run_forever(self):
        await self.initialize()
        self.is_running = True
        self.logger.info("Starting Polling Loop...")

        while self.is_running:
            try:
                # A. Token Refresh & Update
                token = await self.auth.get_token_async()
                self.client.update_token(token)

                # B. Polling Logic
                active_chats = await self.client.get_recent_chats(limit=10)
                now = datetime.now(timezone.utc)

                for chat in active_chats:
                    chat_id = chat['id']
                    
                    # [New] 取得聊天室類型 (oneOnOne, group, meeting)
                    chat_type = chat.get('chatType', 'oneOnOne') 

                    # 確保 Session 存在並更新 Context
                    # 這樣 process_message 就不需要再查一次 API
                    session = self.memory.get_session(chat_id)
                    if not session:
                        self.memory.create_session(chat_id)
                    
                    # 將 chat_type 更新進 context
                    self.memory.set_context(chat_id, "chat_type", chat_type)

                    # 初始化 Checkpoint
                    if chat_id not in self.chat_checkpoints:
                        self.chat_checkpoints[chat_id] = now
                        continue
                    
                    # C. 抓取新訊息
                    last_check = self.chat_checkpoints[chat_id]
                    new_msgs = await self.client.get_new_messages(chat_id, last_check)
                    
                    if new_msgs:
                        self.chat_checkpoints[chat_id] = now
                        for msg in new_msgs:
                            asyncio.create_task(self.process_message(chat_id, msg))
                
                # ... (後續 clean up 邏輯不變) ...





