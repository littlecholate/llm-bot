#include <stdio.h>

// 模擬檢查權限的函式
int check_permission(int user_id) {
    if (user_id > 0) {
        return 1; // OK
    }
    return 0; // Fail
}

// 模擬執行核心任務的函式
void process_data() {
    printf("Processing data...\n");
}

// 主程式
int main() {
    int user_id = 10;
    
    // 這裡的 if-else 邏輯，透過函式呼叫 (Call) 才能被 Sequence Diagram 捕捉
    if (check_permission(user_id)) {
        process_data();
    } else {
        printf("Access Denied\n");
    }
    
    return 0;
}





