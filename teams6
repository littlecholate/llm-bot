    async def get_new_messages(self, chat_id: str, last_check_time: datetime) -> List[Dict]:
        """
        [修正版 v3] 支援偵測 Self-Message Reactions
        """
        url = f"{self.base_url}/me/chats/{chat_id}/messages?$top=20&$sort=lastModifiedDateTime desc"
        
        data = await self._request("GET", url)
        raw_messages = data.get("value", [])
        new_messages = []
        
        if last_check_time.tzinfo is None:
            last_check_time = last_check_time.replace(tzinfo=timezone.utc)

        for msg in raw_messages:
            # 取得發送者 ID
            from_data = msg.get("from") or {}
            user_data = from_data.get("user") or {}
            sender_id = user_data.get("id")

            # --- [關鍵修改 Start] ---
            # 判斷是否為機器人自己
            is_self = (self.user_id and sender_id == self.user_id)
            
            # 判斷是否有 Reactions
            reactions = msg.get("reactions") or []
            has_reactions = len(reactions) > 0

            # 規則：
            # 1. 如果是別人的訊息 -> 保留
            # 2. 如果是自己的訊息 且 有被按讚 -> 保留 (為了觸發結束機制)
            # 3. 如果是自己的訊息 且 無按讚 -> 丟棄
            if is_self and not has_reactions:
                continue
            # --- [關鍵修改 End] ---

            # 時間檢查
            created_str = msg.get("lastModifiedDateTime")
            if not created_str:
                continue
            try:
                msg_time = dateutil.parser.isoparse(created_str)
            except Exception:
                continue
            
            if msg_time > last_check_time:
                new_messages.append(msg)

        new_messages.reverse()
        return new_messages

    async def send_reply(self, chat_id: str, content: str) -> Optional[str]:
        """
        [Modified] 發送回覆並回傳 Message ID
        """
        url = f"{self.base_url}/me/chats/{chat_id}/messages"
        html_content = content.replace("\n", "<br>")
        payload = {
            "body": {
                "contentType": "html",
                "content": f"<div>{html_content}</div>"
            }
        }
        
        # 改為接收回傳值
        data = await self._request("POST", url, json_data=payload)
        return data.get("id")





