    "username": "my_user",
    "password": "my_password",
    "submit": "Login",  # Some legacy forms need the button name too
    "_csrf": "xyz..."   # If there is a hidden token in the HTML, include it here
}

print(f"🚀 Sending POST request to: {url}")

