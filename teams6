# core/bot_instance.py

    async def process_message(self, chat_id: str, message: Dict):
        try:
            msg_id = message.get('id')
            body_data = message.get('body') or {}
            content = body_data.get('content', '')
            
            # --- [Logic A: 檢查是否為「回饋訊息」被按讚] ---
            # 從 Context 取出我們上次發送的 Feedback Message ID
            expected_feedback_id = self.memory.get_context(chat_id, "feedback_msg_id")
            
            # 如果收到的訊息 ID 吻合，且包含 reactions
            if expected_feedback_id and msg_id == expected_feedback_id:
                reactions = message.get('reactions') or []
                if reactions:
                    self.logger.info(f"Feedback received on {msg_id}. Terminating session.")
                    # 強制結算
                    await self.archive_session(chat_id, reason="User Feedback")
                    return # 結束處理，不再當作對話內容

            # --- [Logic B: 正常對話處理] ---
            # 如果是機器人自己的訊息(且沒被上面的 Logic A 攔截)，則忽略，避免自己跟自己對話
            from_user = message.get('from', {}).get('user', {})
            sender_id = from_user.get('id')
            if self.client.user_id and sender_id == self.client.user_id:
                return

            if not content:
                return

            clean_content = content.replace('<p>', '').replace('</p>', '').strip()
            self.logger.info(f"Received from {chat_id}: {clean_content}")

            # 1. 會話管理 (Create/Set)
            session = self.memory.get_session(chat_id)
            if not session:
                self.memory.create_session(chat_id)
                self.memory.set_context(chat_id, "model_used", self.llm_engine.model)

            # 2. 記錄使用者訊息
            self.memory.add_message(chat_id, "user", clean_content)

            # 3. LLM 生成
            history = self.memory.get_history(chat_id)
            reply_content = await self.llm_engine.generate_response(history, self.system_prompt)
            
            # 4. 發送 LLM 回覆
            self.memory.add_message(chat_id, "assistant", reply_content)
            await self.client.send_reply(chat_id, reply_content)

            # 5. [New] 發送「回饋引導訊息」並紀錄 ID
            feedback_text = "✨ <b>如果這個回答有幫助，請對此訊息按讚(React)以結束對話。</b>"
            feedback_msg_id = await self.client.send_reply(chat_id, feedback_text)
            
            if feedback_msg_id:
                self.memory.set_context(chat_id, "feedback_msg_id", feedback_msg_id)

        except Exception as e:
            self.logger.error(f"Error processing message in {chat_id}: {e}", exc_info=True)

    async def archive_session(self, chat_id: str, reason: str = "Timeout"):
        """
        [Refactor] 將歸檔邏輯獨立出來，供 Timeout 和 Feedback 共用
        """
        # 根據 reason 決定呼叫哪種 pop 方法
        if reason == "User Feedback":
            history = self.memory.force_archive_session(chat_id)
        else:
            # 這裡是原本 handle_expired_sessions 的邏輯，但為了共用，我們假設外面傳進來的是單一 chat
            # 為了保持架構簡單，我們讓 handle_expired_sessions 繼續負責 timeout
            return 

        if history:
            self.logger.info(f"Archiving chat {chat_id} (Reason: {reason})...")
            conversation_text = ""
            for msg in history:
                conversation_text += f"[{msg['timestamp']}] {msg['role']}: {msg['content']}\n"
            
            summary = f"[{self.name}] Chat Archive ({reason})"
            ticket_key = await self.jira_client.create_ticket(summary, conversation_text)
            self.logger.info(f"Jira Ticket: {ticket_key}")

    async def handle_expired_sessions(self):
        """
        處理因時間過期而結束的對話
        """
        expired_sessions = self.memory.pop_expired_sessions()
        for chat_id, history in expired_sessions.items():
            # 這裡可以直接複用 archive 邏輯，或者手動寫入 Jira
            # 為了簡單演示，我們手動寫入
            self.logger.info(f"Session timeout: {chat_id}")
            conversation_text = "\n".join([f"{m['role']}: {m['content']}" for m in history])
            await self.jira_client.create_ticket(f"[{self.name}] Timeout Archive", conversation_text)





from curl_cffi import requests
import time

class StealthBot:
    def __init__(self, token=None):
        # 使用 Session 可以自動管理 Cookies，讓行為更像真人
        self.session = requests.Session()
        
        # 核心關鍵：指定要偽裝的瀏覽器指紋 (目前建議用 chrome124 或 chrome120)
        # 這行程式碼會自動調整 TLS 握手細節和 Header 排序
        self.impersonate_target = "chrome124"
        
        self.token = token
        
        # 設定基礎 Headers (雖然 impersonate 會幫忙，但手動補上常見 Header 更保險)
        self.session.headers.update({
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
            "Accept": "application/json, text/plain, */*",
            "Accept-Language": "zh-TW,zh;q=0.9,en-US;q=0.8,en;q=0.7",
            # 如果你有 Token，可以直接預設帶入
            "Authorization": f"Bearer {self.token}" if self.token else ""
        })

    def send_post(self, url, data):
        """ 模擬 POST 請求 (通常用於登入或送出表單) """
        try:
            print(f"🚀 正在發送 POST 請求: {url}")
            
            # 注意：這裡使用 impersonate 參數
            response = self.session.post(
                url, 
                json=data, 
                impersonate=self.impersonate_target,
                timeout=30 # 建議設定超時，避免卡死
            )
            
            # 檢查是否成功
            if response.status_code == 200:
                print("✅ POST 成功！")
                return response.json()
            elif response.status_code == 401:
                print("❌ 401 Unauthorized: Token 可能失效或被拒絕")
            elif response.status_code == 503:
                print("🛡️ 503 Detected: 遇到強效防火牆 (Cloudflare等)")
            else:
                print(f"⚠️ 其他狀態碼: {response.status_code}")
                
            return response.text

        except Exception as e:
            print(f"💥 發生錯誤: {e}")
            return None

    def send_get(self, url):
        """ 模擬 GET 請求 (通常用於抓取資料) """
        try:
            print(f"🔍 正在發送 GET 請求: {url}")
            
            response = self.session.get(
                url, 
                impersonate=self.impersonate_target,
                timeout=30
            )
            
            if response.status_code == 200:
                print("✅ GET 成功！資料長度:", len(response.text))
                return response.json() # 如果回傳是 JSON
            else:
                print(f"❌ 請求失敗: {response.status_code}")
                print("回應內容:", response.text[:200]) # 印出前200字除錯
                return None
                
        except Exception as e:
            print(f"💥 發生錯誤: {e}")
            return None

