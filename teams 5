# services/memory_store.py
import logging
from datetime import datetime, timedelta, timezone
from typing import Dict, List, Any, Optional

logger = logging.getLogger("MemoryStore")

class MemoryStore:
    def __init__(self, session_timeout_minutes: int = 5):
        # 結構: { chat_id: { "last_active": datetime, "history": [msg1, msg2...] } }
        self._sessions: Dict[str, Dict[str, Any]] = {}
        self.timeout_delta = timedelta(minutes=session_timeout_minutes)

    def get_session(self, chat_id: str) -> Optional[Dict[str, Any]]:
        """
        [New] 取得目前的會話資訊。如果不存在則回傳 None。
        """
        return self._sessions.get(chat_id)

    def create_session(self, chat_id: str):
        """
        [New] 建立一個新的會話空間 (Set Chat Info)
        """
        if chat_id not in self._sessions:
            logger.info(f"[{chat_id}] Initializing new session container.")
            self._sessions[chat_id] = {
                "last_active": datetime.now(timezone.utc),
                "history": []
            }

    def add_message(self, chat_id: str, role: str, content: str):
        """
        [Modified] 純粹負責新增訊息與更新時間。
        注意：呼叫此方法前，外部應確保 session 已經透過 create_session 建立。
        """
        now = datetime.now(timezone.utc)
        
        # 安全防護：雖然外部應該要先 create，但這裡防呆一下
        if chat_id not in self._sessions:
            logger.warning(f"[{chat_id}] Session not found during add_message. Auto-creating.")
            self.create_session(chat_id)
        
        # 更新最後活躍時間
        self._sessions[chat_id]["last_active"] = now
        
        # 新增訊息
        self._sessions[chat_id]["history"].append({
            "role": role,
            "content": content,
            "timestamp": now.isoformat()
        })

    def get_history(self, chat_id: str) -> List[Dict]:
        """取得特定 Chat 的完整對話紀錄"""
        return self._sessions.get(chat_id, {}).get("history", [])

    def pop_expired_sessions(self) -> Dict[str, List[Dict]]:
        """檢查並『取出』過期的對話 (用於歸檔)"""
        now = datetime.now(timezone.utc)
        expired_chats = {}
        active_ids = list(self._sessions.keys())

        for chat_id in active_ids:
            session = self._sessions[chat_id]
            if now - session["last_active"] > self.timeout_delta:
                expired_chats[chat_id] = session["history"]
                del self._sessions[chat_id]
        
        return expired_chats





