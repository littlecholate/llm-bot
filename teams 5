# core/bot_instance.py (部分程式碼)

    async def process_message(self, chat_id: str, message: Dict):
        try:
            body_data = message.get('body') or {}
            user_content = body_data.get('content', '')
            if not user_content:
                return

            # 解析發送者資訊 (從 Graph API 訊息結構中抓取)
            from_user = message.get('from', {}).get('user', {})
            sender_name = from_user.get('displayName', 'Unknown User')
            
            clean_content = user_content.replace('<p>', '').replace('</p>', '').strip()
            self.logger.info(f"Received from {chat_id} ({sender_name}): {clean_content}")

            # --- [Step 1: Check Session] ---
            session = self.memory.get_session(chat_id)
            
            # --- [Step 2: Create & Set Initial Info] ---
            if not session:
                self.logger.info(f"No active session for {chat_id}. Creating new one.")
                self.memory.create_session(chat_id)
                
                # [New] 設定初始 Context
                self.memory.set_context(chat_id, "sender_name", sender_name)
                self.memory.set_context(chat_id, "start_time", datetime.now().isoformat())
                self.memory.set_context(chat_id, "model_used", self.llm_engine.model) # 紀錄目前使用的模型
            
            # --- [Step 3: Add User Message] ---
            self.memory.add_message(chat_id, "user", clean_content)

            # --- [Step 4: LLM Generation] ---
            history = self.memory.get_history(chat_id)
            
            # (進階應用) 如果你想根據 sender_name 客製化 System Prompt，可以在這裡取出 context
            # stored_name = self.memory.get_context(chat_id, "sender_name")
            # custom_prompt = f"Hi {stored_name}, {self.system_prompt}"

            reply_content = await self.llm_engine.generate_response(history, self.system_prompt)
            
            # --- [Step 5: Reply & Update Info] ---
            self.memory.add_message(chat_id, "assistant", reply_content)
            
            # [New] 你甚至可以根據 LLM 的回覆更新 Context (例如 LLM 判斷使用者意圖是 'booking')
            # self.memory.set_context(chat_id, "last_intent", "chat") 

            await self.client.send_reply(chat_id, reply_content)

        except Exception as e:
            self.logger.error(f"Error processing message in {chat_id}: {e}", exc_info=True)

