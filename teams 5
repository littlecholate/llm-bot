# services/memory_store.py
import logging
from datetime import datetime, timedelta, timezone
from typing import Dict, List, Any, Optional

logger = logging.getLogger("MemoryStore")

class MemoryStore:
    def __init__(self, session_timeout_minutes: int = 5):
        # 結構變更:
        # {
        #   chat_id: {
        #       "last_active": datetime,
        #       "history": [...],
        #       "context": { "model": "gpt-4", "user_name": "Leo", ... }  <-- New
        #   }
        # }
        self._sessions: Dict[str, Dict[str, Any]] = {}
        self.timeout_delta = timedelta(minutes=session_timeout_minutes)

    def get_session(self, chat_id: str) -> Optional[Dict[str, Any]]:
        return self._sessions.get(chat_id)

    def create_session(self, chat_id: str, initial_context: Dict = None):
        """
        [Modified] 建立會話，可選傳入初始 Context
        """
        if chat_id not in self._sessions:
            logger.info(f"[{chat_id}] Initializing new session container.")
            self._sessions[chat_id] = {
                "last_active": datetime.now(timezone.utc),
                "history": [],
                "context": initial_context or {}  # 初始化 Context
            }

    def set_context(self, chat_id: str, key: str, value: Any):
        """
        [New] 設定額外的 Session 資訊 (如 model info, user state)
        """
        if chat_id in self._sessions:
            self._sessions[chat_id]["context"][key] = value
        else:
            logger.warning(f"[{chat_id}] Cannot set context. Session does not exist.")

    def get_context(self, chat_id: str, key: str) -> Any:
        """
        [New] 取得特定的 Context 值
        """
        session = self._sessions.get(chat_id)
        if session:
            return session.get("context", {}).get(key)
        return None

    def add_message(self, chat_id: str, role: str, content: str):
        # ... (保持不變) ...
        now = datetime.now(timezone.utc)
        if chat_id not in self._sessions:
            self.create_session(chat_id)
        
        self._sessions[chat_id]["last_active"] = now
        self._sessions[chat_id]["history"].append({
            "role": role,
            "content": content,
            "timestamp": now.isoformat()
        })

