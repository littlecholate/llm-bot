import os
import re
import uuid
import aiofiles # 建議安裝: uv add aiofiles (非同步檔案寫入)
# ... 其他 imports ...

class TeamsBot:
    # ... (__init__ 等保持不變) ...

    async def _download_and_save_images(self, chat_id: str, content: str) -> List[str]:
        """
        [New] 解析 HTML 內容，下載所有圖片並回傳本地路徑列表
        """
        # 1. 使用 Regex 抓取 src 屬性
        # Teams 的 img tag 通常長這樣: <img src="https://graph.microsoft.com/..." ...>
        img_urls = re.findall(r'<img[^>]+src="([^">]+)"', content)
        
        if not img_urls:
            return []

        saved_paths = []
        
        # 建立暫存資料夾
        save_dir = f"temp_images/{chat_id}"
        os.makedirs(save_dir, exist_ok=True)

        for i, url in enumerate(img_urls):
            # 簡單過濾：只下載微軟 Graph 的連結 (避免外部追蹤像素等)
            # if "graph.microsoft.com" not in url: continue 
            
            self.logger.info(f"Found image, downloading: {url[:50]}...")
            image_data = await self.client.download_image(url)
            
            if image_data:
                # 產生檔名 (使用 uuid 避免衝突)
                filename = f"{uuid.uuid4()}.png" # Teams 圖片通常可直接存為 png 或 jpg
                file_path = os.path.join(save_dir, filename)
                
                # 非同步寫入檔案
                async with aiofiles.open(file_path, 'wb') as f:
                    await f.write(image_data)
                
                saved_paths.append(file_path)
                self.logger.info(f"Image saved to: {file_path}")
            else:
                self.logger.warning("Failed to download one of the images.")

        return saved_paths

    async def process_message(self, chat_id: str, message: Dict):
        try:
            # ... (前略: ID 檢查、Self check 等) ...
            
            body_data = message.get('body') or {}
            content = body_data.get('content', '')
            
            # --- [Modified] ---
            clean_content = content.replace('<p>', '').replace('</p>', '').strip()
            
            # 1. 處理圖片 (下載並儲存)
            image_paths = await self._download_and_save_images(chat_id, content)
            
            if image_paths:
                self.logger.info(f"Processed {len(image_paths)} images from user.")

            # 2. 寫入記憶 (User) - 傳入圖片路徑
            # 注意：這裡將圖片綁定到了 Session Memory 中
            self.memory.add_message(chat_id, "user", clean_content, images=image_paths)

            # 3. 呼叫 LLM Engine
