# core/bot_instance.py
import asyncio
import logging
import importlib
from datetime import datetime, timezone
from typing import Dict

from services.auth_manager import AuthManager
from services.graph_client import GraphClient
from services.memory_store import MemoryStore
from services.llm_engine import LLMEngine      # New
from services.tools.jira_client import JiraClient # New

# 設定 Logger
logging.basicConfig(level=logging.INFO)

class TeamsBot:
    def __init__(self, bot_config: Dict):
        self.config = bot_config
        self.name = bot_config['name']
        self.logger = logging.getLogger(f"BotInstance.{self.name}")
        
        # 初始化服務
        self.auth = AuthManager(bot_config['email'], bot_config['password'])
        self.memory = MemoryStore(session_timeout_minutes=2) # 測試時設短一點，例如 2 分鐘
        self.client: GraphClient = None
        
        # 初始化 LLM 與 Tools
        self.llm_engine = LLMEngine()
        self.jira_client = JiraClient()
        
        # 動態載入 Prompt
        # 假設 config['prompt_module'] 是 "devops_prompt"
        # 我們從 configs.prompts.devops_prompt 載入 SYSTEM_PROMPT 變數
        try:
            module_name = f"configs.prompts.{bot_config['prompt_module']}"
            mod = importlib.import_module(module_name)
            self.system_prompt = getattr(mod, "SYSTEM_PROMPT", "You are a helpful assistant.")
            self.logger.info(f"Loaded system prompt from {module_name}")
        except Exception as e:
            self.logger.error(f"Failed to load prompt module: {e}")
            self.system_prompt = "You are a helpful assistant."

        self.chat_checkpoints: Dict[str, datetime] = {}
        self.is_running = False

    async def initialize(self):
        self.logger.info("Initializing authentication...")
        token = await self.auth.get_token_async()
        self.client = GraphClient(token)
        my_id = await self.client.get_me()
        self.logger.info(f"Bot Ready. User ID: {my_id}")

    async def process_message(self, chat_id: str, message: Dict):
        """
        [整合版] 處理訊息：寫入記憶 -> LLM 生成 -> 回覆
        """
        try:
            body_data = message.get('body') or {}
            user_content = body_data.get('content', '')
            if not user_content:
                return

            clean_content = user_content.replace('<p>', '').replace('</p>', '').strip()
            self.logger.info(f"Received from {chat_id}: {clean_content}")

            # 1. 寫入記憶 (User)
            self.memory.add_message(chat_id, "user", clean_content)

            # 2. 呼叫 LLM Engine
            # 取得目前的完整對話紀錄
            history = self.memory.get_history(chat_id)
            
            # 使用 LLM 生成回覆 (這是真正的 AI 思考了!)
            reply_content = await self.llm_engine.generate_response(history, self.system_prompt)
            
            # 3. 寫入記憶 (Assistant)
            self.memory.add_message(chat_id, "assistant", reply_content)

            # 4. 發送回覆到 Teams
            await self.client.send_reply(chat_id, reply_content)
            self.logger.info(f"Replied to {chat_id}")

        except Exception as e:
            self.logger.error(f"Error processing message in {chat_id}: {e}", exc_info=True)

    async def handle_expired_sessions(self):
        """
        處理過期對話：歸檔到 Jira
        """
        # 從 MemoryStore 取出並移除過期對話
        expired_sessions = self.memory.pop_expired_sessions()
        
        for chat_id, history in expired_sessions.items():
            self.logger.info(f"Session expired: {chat_id}. Archiving to Jira...")
            
            # 格式化對話內容為文字
            conversation_text = ""
            for msg in history:
                timestamp = msg.get("timestamp", "")
                role = msg.get("role", "unknown")
                content = msg.get("content", "")
                conversation_text += f"[{timestamp}] {role}: {content}\n"
            
            # 呼叫 Jira Client 建立 Ticket
            summary = f"[{self.name}] Chat Archive: {chat_id[:10]}..."
            ticket_key = await self.jira_client.create_ticket(
                summary=summary, 
                description=conversation_text
            )
            
            if ticket_key:
                self.logger.info(f"Archived chat {chat_id} to Jira: {ticket_key}")

    async def run_forever(self):
        await self.initialize()
        self.is_running = True
        self.logger.info("Starting Polling Loop...")

        while self.is_running:
            try:
                # A. Token Refresh
                token = await self.auth.get_token_async()
                self.client.update_token(token)

                # B. Polling Logic
                active_chats = await self.client.get_recent_chats(limit=10)
                now = datetime.now(timezone.utc)

                for chat in active_chats:
                    chat_id = chat['id']
                    if chat_id not in self.chat_checkpoints:
                        self.chat_checkpoints[chat_id] = now
                        continue
                    
                    last_check = self.chat_checkpoints[chat_id]
                    new_msgs = await self.client.get_new_messages(chat_id, last_check)
                    
                    if new_msgs:
                        self.chat_checkpoints[chat_id] = now
                        for msg in new_msgs:
                            asyncio.create_task(self.process_message(chat_id, msg))
                
                # C. [New] 處理過期對話並歸檔
                await self.handle_expired_sessions()

                # D. Sleep
                await asyncio.sleep(5)

            except Exception as e:
                self.logger.error(f"Global Loop Error: {e}")
                await asyncio.sleep(10)
