# services/llm_engine.py
import os
import logging
from typing import List, Dict
from openai import AsyncOpenAI

logger = logging.getLogger("LLMEngine")

class LLMEngine:
    def __init__(self):
        self.api_key = os.getenv("OPENAI_API_KEY")
        if not self.api_key:
            logger.warning("OPENAI_API_KEY not found! LLM will fail.")
        
        # 初始化 Async Client
        self.client = AsyncOpenAI(api_key=self.api_key)
        self.model = "gpt-4o-mini" # 或 gpt-3.5-turbo, gpt-4

    async def generate_response(self, history: List[Dict], system_prompt: str) -> str:
        """
        將對話紀錄與 System Prompt 組合，呼叫 LLM 生成回覆
        """
        try:
            # 1. 建構 Messages 列表 (System + History)
            messages = [{"role": "system", "content": system_prompt}]
            
            # 將我們 MemoryStore 的格式 (timestamp, role, content) 轉換為 OpenAI 格式
            for msg in history:
                messages.append({
                    "role": msg["role"], # user 或 assistant
                    "content": msg["content"]
                })

            # 2. 呼叫 OpenAI API
            response = await self.client.chat.completions.create(
                model=self.model,
                messages=messages,
                temperature=0.7,
                max_tokens=800
            )

            # 3. 取得回覆內容
            answer = response.choices[0].message.content
            return answer

        except Exception as e:
            logger.error(f"LLM Generation Error: {e}")
            return "抱歉，我現在無法連接到大腦運算單元，請稍後再試。"






# services/tools/jira_client.py
import os
import aiohttp
import logging
import base64

logger = logging.getLogger("JiraClient")

class JiraClient:
    def __init__(self):
        self.base_url = os.getenv("JIRA_URL")
        self.email = os.getenv("JIRA_EMAIL")
        self.api_token = os.getenv("JIRA_API_TOKEN")
        self.enabled = all([self.base_url, self.email, self.api_token])

        if not self.enabled:
            logger.warning("Jira config missing. Jira features will be disabled.")

    async def create_ticket(self, summary: str, description: str, project_key: str = "IT") -> str:
        """
        建立 Jira Ticket 並回傳 Key (e.g., IT-101)
        """
        if not self.enabled:
            logger.info("Jira is disabled, skipping ticket creation.")
            return "JIRA-DISABLED"

        url = f"{self.base_url}/rest/api/3/issue"
        
        # 建構 Basic Auth Header
        auth_str = f"{self.email}:{self.api_token}"
        b64_auth = base64.b64encode(auth_str.encode()).decode()
        
        headers = {
            "Authorization": f"Basic {b64_auth}",
            "Content-Type": "application/json"
        }

        # Jira Issue Payload
        payload = {
            "fields": {
                "project": {"key": project_key},
                "summary": summary,
                "description": {
                    "type": "doc",
                    "version": 1,
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [{"type": "text", "text": description}]
                        }
                    ]
                },
                "issuetype": {"name": "Task"}
            }
        }

        async with aiohttp.ClientSession() as session:
            try:
                async with session.post(url, headers=headers, json=payload) as resp:
                    if resp.status == 201:
                        data = await resp.json()
                        key = data.get("key")
                        logger.info(f"Jira Ticket Created: {key}")
                        return key
                    else:
                        text = await resp.text()
                        logger.error(f"Failed to create Jira ticket: {resp.status} - {text}")
                        return None
            except Exception as e:
                logger.error(f"Jira Connection Error: {e}")
                return None






