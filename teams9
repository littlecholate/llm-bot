    # ...

    async def send_reply(self, chat_id: str, content: str, is_html: bool = True) -> Optional[str]:
        """
        :param is_html: 如果外部已經轉好 HTML，傳入 True，就不再做換行處理
        """
        url = f"{self.base_url}/me/chats/{chat_id}/messages"
        
        # 如果已經是 HTML (來自 Markdown converter)，直接用
        # 如果是純文字 (例如系統錯誤訊息)，才做簡單轉換
        if is_html:
            final_content = content
        else:
            final_content = content.replace("\n", "<br>")
        
        payload = {
            "body": {
                "contentType": "html",
                "content": final_content # 這裡不需要再包 <div>，因為 converter 已經包了
            }
        }
        
        data = await self._request("POST", url, json_data=payload)
        return data.get("id")

    async def edit_message(self, chat_id: str, message_id: str, new_content: str, is_html: bool = True):
        url = f"{self.base_url}/me/chats/{chat_id}/messages/{message_id}"
        
        if is_html:
            final_content = new_content
        else:
            final_content = new_content.replace("\n", "<br>")
            
        payload = {
            "body": {
                "contentType": "html",
                "content": final_content
            }
        }
        
        await self._request("PATCH", url, json_data=payload)
