            final_content = content
        else:
            final_content = content.replace("\n", "<br>")
        
        payload = {
            "body": {
                "contentType": "html",
                "content": final_content # 這裡不需要再包 <div>，因為 converter 已經包了
            }
        }
        
        data = await self._request("POST", url, json_data=payload)
