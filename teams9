# utils/text_converter.py
import markdown

def markdown_to_teams_html(markdown_text: str) -> str:
    """
    將 LLM 的 Markdown 格式轉換為 Teams 支援的 HTML
    """
    if not markdown_text:
        return ""

    # 使用 Python markdown 庫進行轉換
    # extensions 說明:
    # - fenced_code: 支援 ```python ... ``` 這種區塊
    # - tables: 支援 Markdown 表格
    # - nl2br: 將換行符號轉換為 <br> (選擇性開啟，視 LLM 輸出習慣而定)
    # - sane_lists: 優化列表的識別
    html = markdown.markdown(
        markdown_text,
        extensions=['fenced_code', 'tables', 'sane_lists']
    )

    # --- Teams 特殊優化 ---
    # Teams 的 HTML 對某些標籤有潔癖，可以在這裡做額外處理
    # 這裡是一個簡單的後處理範例：
    
    # 1. 確保內容被 div 包裹 (Teams 建議)
    if not html.startswith("<div>"):
        html = f"<div>{html}</div>"
        
    return html





