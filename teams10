# ----------------------------------------------------------------
# Stage 1: Builder (負責安裝依賴)
# ----------------------------------------------------------------
FROM python:3.11-slim-bookworm AS builder

# 安裝 uv (從官方 image 複製執行檔，最快最穩)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# 設定工作目錄
WORKDIR /app

# 複製依賴定義檔
COPY pyproject.toml uv.lock ./

# 安裝依賴
# --frozen: 嚴格依照 uv.lock 安裝
# --no-dev: 不安裝開發用套件 (如 pytest)
# --compile: 編譯 byte code 加快啟動速度
ENV UV_COMPILE_BYTECODE=1
RUN uv sync --frozen --no-dev

# ----------------------------------------------------------------
# Stage 2: Runtime (實際執行的環境)
# ----------------------------------------------------------------
FROM python:3.11-slim-bookworm

# 安裝基礎工具 (curl 用於 healthcheck, tzdata 用於時區)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates tzdata && \
    rm -rf /var/lib/apt/lists/*

# 設定時區為台北 (解決 Log 時間與 Azure UTC 差異問題)
ENV TZ=Asia/Taipei

# 設定工作目錄
WORKDIR /app

# 從 Builder 階段複製虛擬環境
# 這裡我們把 builder 建立的 .venv 複製過來，這樣 Runtime image 就不用裝 uv 了，體積更小
COPY --from=builder /app/.venv /app/.venv

# 複製程式碼
COPY . .

# 建立必要的資料夾並調整權限
# 我們建立一個非 root 使用者 'appuser' 來執行程式，提升安全性
RUN mkdir -p temp_images logs && \
    adduser --disabled-password --gecos "" appuser && \
    chown -R appuser:appuser /app

# 切換為非 root 使用者
USER appuser

# 設定 PATH，讓系統優先使用虛擬環境的 python
ENV PATH="/app/.venv/bin:$PATH"

# 啟動指令
CMD ["python", "main.py"]





