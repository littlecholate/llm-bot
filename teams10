# utils/file_cleaner.py
import os
import time
import asyncio
import logging

logger = logging.getLogger("FileCleaner")

async def cleanup_temp_files(folder_path: str, max_age_minutes: int = 60):
    """
    非同步執行：刪除指定資料夾中超過 max_age_minutes 的檔案
    """
    def _sync_clean():
        now = time.time()
        cutoff = now - (max_age_minutes * 60)
        
        if not os.path.exists(folder_path):
            return

        count = 0
        for filename in os.listdir(folder_path):
            file_path = os.path.join(folder_path, filename)
            try:
                # 檢查最後修改時間
                if os.path.isfile(file_path) and os.path.getmtime(file_path) < cutoff:
                    os.remove(file_path)
                    count += 1
            except Exception as e:
                logger.warning(f"Failed to delete {filename}: {e}")
        
        if count > 0:
            logger.info(f"Cleaned up {count} old files in {folder_path}")

    # 使用 to_thread 避免 os.remove 阻塞 Main Loop
    await asyncio.to_thread(_sync_clean)





