# --- [New] 定義背景維護任務 ---
async def run_maintenance_task():
    """
    背景維護迴圈：每小時檢查並清理過期的暫存圖片
    """
    temp_root = "temp_images"
    logger.info("Starting Maintenance Task (File Cleaner)...")
    
    # 確保根目錄存在，避免報錯
    if not os.path.exists(temp_root):
        os.makedirs(temp_root, exist_ok=True)

    while True:
        try:
            # 1. 遍歷 temp_images 下的所有聊天室資料夾
            # 結構: temp_images/ <chat_id> / <image.png>
            if os.path.exists(temp_root):
                sub_folders = [f for f in os.listdir(temp_root) if os.path.isdir(os.path.join(temp_root, f))]
                
                for chat_folder in sub_folders:
                    full_folder_path = os.path.join(temp_root, chat_folder)
                    
                    # 呼叫 utils 清理該資料夾 (保留 60 分鐘內的檔案)
                    await cleanup_temp_files(full_folder_path, max_age_minutes=60)
            
            # 2. 休息 1 小時 (3600 秒) 後再執行
            await asyncio.sleep(3600)

        except asyncio.CancelledError:
            logger.info("Maintenance task cancelled.")
            break
        except Exception as e:
            logger.error(f"Maintenance task error: {e}")
            # 發生錯誤時，休息 5 分鐘再試，避免死迴圈狂刷 Log
            await asyncio.sleep(300)

async def main():
    """
    系統入口點：讀取設定 -> 初始化 Bots -> 併發執行
    """
    logger.info("--- Starting Multi-Bot System ---")

    active_configs = [cfg for cfg in BOTS_CONFIGURATION if cfg.get('enabled')]
    
    if not active_configs:
        logger.error("No enabled bots found! Exiting.")
        return

    logger.info(f"Found {len(active_configs)} enabled bots: {[c['name'] for c in active_configs]}")

    # 收集所有要執行的非同步任務
    all_tasks = []

    # 1. 加入 Bots 任務
    for config in active_configs:
        try:
            bot = TeamsBot(config)
            all_tasks.append(bot.run_forever())
            logger.info(f"Bot instance created: {config['name']}")
        except Exception as e:
            logger.error(f"Failed to initialize bot {config['name']}: {e}")

    # 2. [New] 加入維護任務
    all_tasks.append(run_maintenance_task())

    # 3. 同時啟動所有任務
    logger.info(">>> All Bots & Services Launched. Press Ctrl+C to stop. <<<")
    
    try:
        # 使用 asyncio.gather 並發執行 (Bot A, Bot B, Cleaner...)
        await asyncio.gather(*all_tasks)
    except asyncio.CancelledError:
        logger.info("Tasks cancelled. Shutting down...")
    except Exception as e:
        logger.error(f"Unexpected system crash: {e}", exc_info=True)

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("\n--- System Shutdown Requested (KeyboardInterrupt) ---")
        logger.info("Goodbye!")





